# Copia este archivo a  .env  y completa tus valores. NUNCA subas .env a Git.

# --- Base de datos PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sportspot
DB_USER=postgres
DB_PASSWORD=TU_CONTRASENA_DE_POSTGRES
PORT=4000
JWT_SECRET=cambia_este_secreto_por_uno_largo

# --- Google Auth (solo el Client ID; el flujo de login no usa el secret) ---
GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# --- PayPal Sandbox (se usa en la fase de pagos) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
