# Copia este archivo a  .env  y completa tus valores. Vite solo expone las VITE_*.
# Todos estos son datos PUBLICOS (viajan al navegador). Los secrets van en el backend.

# URL del API (por defecto http://localhost:4000 si se omite)
VITE_API_URL=http://localhost:4000

# Client ID de Google (login con Google en el panel)
VITE_GOOGLE_CLIENT_ID=TU_CLIENT_ID.apps.googleusercontent.com

# Client ID de PayPal Sandbox (mismo app que el PAYPAL_CLIENT_ID del backend).
# 'sb' solo renderiza los botones para probar la UI; para cobrar en Sandbox pon el tuyo.
VITE_PAYPAL_CLIENT_ID=TU_PAYPAL_CLIENT_ID
